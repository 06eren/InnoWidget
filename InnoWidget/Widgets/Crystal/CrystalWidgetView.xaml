<UserControl x:Class="InnoWidget.Widgets.Crystal.CrystalWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="280" d:DesignWidth="420">
    <Border Background="#F0E6FF" BorderBrush="#E6E6FA" BorderThickness="3" CornerRadius="20" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="#E6E6FA" BlurRadius="20" ShadowDepth="4" Opacity="0.7" />
        </Border.Effect>
        
        <Grid>
            <Canvas x:Name="CrystalCanvas" IsHitTestVisible="False" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Crystal Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <svgc:SvgViewbox Width="32" Height="32" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/crystal.svg">
                            <svgc:SvgViewbox.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="1" Duration="0:0:1.5" AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:4" />
                                            <ColorAnimation Storyboard.TargetProperty="(UIElement.Fill).(SolidColorBrush.Color)" 
                                                           To="#DDA0DD" Duration="0:0:2" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </svgc:SvgViewbox.Triggers>
                            <svgc:SvgViewbox.RenderTransform>
                                <RotateTransform CenterX="16" CenterY="16" />
                            </svgc:SvgViewbox.RenderTransform>
                        </svgc:SvgViewbox>
                        <TextBlock Text="💎 CRYSTAL MONITOR 💎" FontSize="22" FontWeight="Bold" Foreground="#E6E6FA" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#E6E6FA" BlurRadius="10" ShadowDepth="3" />
                            </TextBlock.Effect>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                           To="#DDA0DD" Duration="0:0:3" AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.7" To="1" Duration="0:0:2" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="💎 GEMSTONE ANALYZER 💎 CRYSTAL ENERGY 💎" FontSize="16" Foreground="#E6E6FA" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#E6E6FA" BlurRadius="8" ShadowDepth="3" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <Button Grid.Column="2" Width="35" Height="35" Background="Transparent" BorderThickness="0" Padding="0"
                            Command="{Binding ToggleSettingsCommand}" ToolTip="Ayarlar">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="5">
                                    <svgc:SvgViewbox Width="20" Height="20" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/settings.svg" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Purity Bar -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <svgc:SvgViewbox Width="24" Height="24" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/crystal.svg">
                            <svgc:SvgViewbox.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.4" To="1" Duration="0:0:1.8" AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.8" To="1.2" Duration="0:0:2.5" AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.8" To="1.2" Duration="0:0:2.5" AutoReverse="True" />
                                            <ColorAnimation Storyboard.TargetProperty="(UIElement.Fill).(SolidColorBrush.Color)" 
                                                           To="#DDA0DD" Duration="0:0:2.5" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </svgc:SvgViewbox.Triggers>
                            <svgc:SvgViewbox.RenderTransform>
                                <ScaleTransform CenterX="12" CenterY="12" />
                            </svgc:SvgViewbox.RenderTransform>
                        </svgc:SvgViewbox>
                        <TextBlock Text="PURE" Foreground="#E6E6FA" FontWeight="Bold" Margin="8,0,0,0" FontSize="16">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                           To="#DDA0DD" Duration="0:0:3" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#F5F0FF" CornerRadius="15" Height="25" Margin="10,0">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Purity, Mode=OneWay}" 
                                     Background="Transparent" Foreground="#E6E6FA" BorderThickness="0">
                            <ProgressBar.Effect>
                                <DropShadowEffect Color="#E6E6FA" BlurRadius="12" ShadowDepth="3" />
                            </ProgressBar.Effect>
                            <ProgressBar.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.8" To="1" Duration="0:0:2" AutoReverse="True" />
                                            <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                           To="#DDA0DD" Duration="0:0:3" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ProgressBar.Triggers>
                        </ProgressBar>
                    </Border>

                    <TextBlock Grid.Column="2" Text="{Binding Purity, StringFormat={}{0:0}%}" 
                               Foreground="#E6E6FA" FontWeight="Bold" FontSize="16" 
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#E6E6FA" BlurRadius="10" ShadowDepth="3" />
                        </TextBlock.Effect>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                       To="#DDA0DD" Duration="0:0:3.5" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="1" Duration="0:0:1.5" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </Grid>

                <!-- Crystal Status -->
                <Grid Grid.Row="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <svgc:SvgViewbox Width="24" Height="24" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/crystal.svg">
                            <svgc:SvgViewbox.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="1" Duration="0:0:2.5" AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:8" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </svgc:SvgViewbox.Triggers>
                            <svgc:SvgViewbox.RenderTransform>
                                <RotateTransform CenterX="12" CenterY="12" />
                            </svgc:SvgViewbox.RenderTransform>
                        </svgc:SvgViewbox>
                        <TextBlock Text="STATUS" Foreground="#E6E6FA" FontWeight="Bold" Margin="8,0,0,0" FontSize="16">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                           To="#DDA0DD" Duration="0:0:4" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="💎 CRYSTAL POWER 💎 GEMSTONE ENERGY 💎 SACRED FREQUENCY 💎" FontSize="14" Foreground="#E6E6FA" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#E6E6FA" BlurRadius="15" ShadowDepth="5" />
                        </TextBlock.Effect>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                       To="#FFD700" Duration="0:0:5" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>

                    <TextBlock Grid.Column="2" Text="💎" Foreground="#E6E6FA" FontWeight="Bold" FontSize="20" 
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                       To="#FFD700" Duration="0:0:3" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:2" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.6" To="1.4" Duration="0:0:2.5" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.6" To="1.4" Duration="0:0:2.5" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                        <TextBlock.RenderTransform>
                            <ScaleTransform CenterX="10" CenterY="10" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
