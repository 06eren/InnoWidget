<UserControl x:Class="InnoWidget.Widgets.Network.NetworkWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="360">
    <Border Background="#0A0A0A" BorderBrush="#00FFFF" BorderThickness="3" CornerRadius="20" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="#00FFFF" BlurRadius="20" ShadowDepth="4" Opacity="0.7" />
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="15" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="15" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="15" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="15" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Bar Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <svgc:SvgViewbox Width="24" Height="24" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/drink.svg">
                        <svgc:SvgViewbox.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.7" To="1" Duration="0:0:2" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </svgc:SvgViewbox.Triggers>
                    </svgc:SvgViewbox>
                    <TextBlock Text="NETWORK BAR" FontSize="18" FontWeight="Bold" Foreground="#00CED1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#00CED1" BlurRadius="4" ShadowDepth="1" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="1" Text=" INTERNET SPEED " FontSize="14" Foreground="#00CED1" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00CED1" BlurRadius="3" ShadowDepth="1" />
                    </TextBlock.Effect>
                </TextBlock>

                <Button Grid.Column="2" Width="30" Height="30" Background="Transparent" BorderThickness="0" Padding="0"
                        ToolTip="Ayarlar">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="4">
                                <svgc:SvgViewbox Width="16" Height="16" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/settings.svg" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Download Bar -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <svgc:SvgViewbox Width="20" Height="20" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/network.svg" />
                    <TextBlock Text="DOWN" Foreground="#00CED1" FontWeight="Bold" Margin="6,0,0,0" />
                </StackPanel>

                <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="4" Height="20" Margin="8,0">
                    <ProgressBar Minimum="0" Maximum="100" Value="75" 
                                 Background="Transparent" Foreground="#00CED1" BorderThickness="0">
                        <ProgressBar.Effect>
                            <DropShadowEffect Color="#00CED1" BlurRadius="4" ShadowDepth="1" />
                        </ProgressBar.Effect>
                    </ProgressBar>
                </Border>

                <TextBlock Grid.Column="2" Text="{Binding DownloadText}" 
                           Foreground="#00CED1" FontWeight="Bold" FontSize="12" 
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00CED1" BlurRadius="4" ShadowDepth="1" />
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>

            <!-- Upload Bar -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <svgc:SvgViewbox Width="20" Height="20" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/network.svg" />
                    <TextBlock Text="UP" Foreground="#00CED1" FontWeight="Bold" Margin="6,0,0,0" />
                </StackPanel>

                <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="4" Height="20" Margin="8,0">
                    <ProgressBar Minimum="0" Maximum="100" Value="45" 
                                 Background="Transparent" Foreground="#FF6B35" BorderThickness="0">
                        <ProgressBar.Effect>
                            <DropShadowEffect Color="#FF6B35" BlurRadius="4" ShadowDepth="1" />
                        </ProgressBar.Effect>
                    </ProgressBar>
                </Border>

                <TextBlock Grid.Column="2" Text="{Binding UploadText}" 
                           Foreground="#FF6B35" FontWeight="Bold" FontSize="12" 
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF6B35" BlurRadius="4" ShadowDepth="1" />
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>

            <!-- Connection Status -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <svgc:SvgViewbox Width="20" Height="20" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/bar.svg" />
                    <TextBlock Text="STATUS" Foreground="#00CED1" FontWeight="Bold" Margin="6,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text=" ULTRA FAST CONNECTION " FontSize="12" Foreground="#00CED1" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00CED1" BlurRadius="3" ShadowDepth="1" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock Grid.Column="2" Text="FAST" Foreground="#00FF00" FontWeight="Bold" FontSize="14" 
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00FF00" BlurRadius="4" ShadowDepth="1" />
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>

            <!-- Bandwidth Status -->
            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <svgc:SvgViewbox Width="20" Height="20" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/cocktail.svg">
                        <svgc:SvgViewbox.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </svgc:SvgViewbox.Triggers>
                        <svgc:SvgViewbox.RenderTransform>
                            <RotateTransform CenterX="10" CenterY="10" />
                        </svgc:SvgViewbox.RenderTransform>
                    </svgc:SvgViewbox>
                    <TextBlock Text="BAND" Foreground="#00CED1" FontWeight="Bold" Margin="6,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text=" PREMIUM BANDWIDTH  UNLIMITED " FontSize="12" Foreground="#00CED1" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00CED1" BlurRadius="6" ShadowDepth="2" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock Grid.Column="2" Text="MAX" Foreground="#FF1493" FontWeight="Bold" FontSize="14" 
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF1493" BlurRadius="4" ShadowDepth="1" />
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>

            <!-- Streaming Status -->
            <Grid Grid.Row="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <svgc:SvgViewbox Width="20" Height="20" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/music-note.svg">
                        <svgc:SvgViewbox.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="1" Duration="0:0:1.2" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </svgc:SvgViewbox.Triggers>
                    </svgc:SvgViewbox>
                    <TextBlock Text="STREAM" Foreground="#00CED1" FontWeight="Bold" Margin="6,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text=" LIVE STREAMING  4K QUALITY " FontSize="12" Foreground="#FF1493" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF1493" BlurRadius="6" ShadowDepth="2" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock Grid.Column="2" Text="" Foreground="#FF1493" FontWeight="Bold" FontSize="16" 
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="1" Duration="0:0:1" AutoReverse="True" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </Grid>
        </Grid>
    </Border>
</UserControl>
