<UserControl x:Class="InnoWidget.Widgets.Media.MediaWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="360">
    <Border Background="#1A0033" BorderBrush="#FF1493" BorderThickness="3" CornerRadius="20" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="#FF1493" BlurRadius="20" ShadowDepth="4" Opacity="0.7" />
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="15" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="15" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="15" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="15" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Bar Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <svgc:SvgViewbox Width="24" Height="24" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/media.svg">
                        <svgc:SvgViewbox.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.7" To="1" Duration="0:0:2" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </svgc:SvgViewbox.Triggers>
                    </svgc:SvgViewbox>
                    <TextBlock Text="MUSIC BAR" FontSize="18" FontWeight="Bold" Foreground="#9370DB" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#9370DB" BlurRadius="4" ShadowDepth="1" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="1" Text=" CLUB MUSIC  DJ MIX " FontSize="14" Foreground="#9370DB" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#9370DB" BlurRadius="3" ShadowDepth="1" />
                    </TextBlock.Effect>
                </TextBlock>

                <Button Grid.Column="2" Width="30" Height="30" Background="Transparent" BorderThickness="0" Padding="0"
                        Command="{Binding ToggleSettingsCommand}" ToolTip="Ayarlar">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="4">
                                <svgc:SvgViewbox Width="16" Height="16" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/settings.svg" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Now Playing -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <svgc:SvgViewbox Width="20" Height="20" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/music-note.svg" />
                    <TextBlock Text="NOW" Foreground="#9370DB" FontWeight="Bold" Margin="6,0,0,0" />
                </StackPanel>

                <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="4" Height="20" Margin="8,0">
                    <ProgressBar Minimum="0" Maximum="100" Value="85" 
                                 Background="Transparent" Foreground="#9370DB" BorderThickness="0">
                        <ProgressBar.Effect>
                            <DropShadowEffect Color="#9370DB" BlurRadius="4" ShadowDepth="1" />
                        </ProgressBar.Effect>
                    </ProgressBar>
                </Border>

                <TextBlock Grid.Column="2" Text="" Foreground="#9370DB" FontWeight="Bold" FontSize="16" 
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="1" Duration="0:0:0.8" AutoReverse="True" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </Grid>

            <!-- Track Title -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <svgc:SvgViewbox Width="20" Height="20" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/media.svg" />
                    <TextBlock Text="TRACK" Foreground="#9370DB" FontWeight="Bold" Margin="6,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text=" ELECTRONIC BEATS  CLUB HITS " FontSize="12" Foreground="#9370DB" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#9370DB" BlurRadius="6" ShadowDepth="2" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock Grid.Column="2" Text="HOT" Foreground="#FF1493" FontWeight="Bold" FontSize="14" 
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF1493" BlurRadius="4" ShadowDepth="1" />
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>

            <!-- Volume Control -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <svgc:SvgViewbox Width="20" Height="20" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/bar.svg" />
                    <TextBlock Text="VOLUME" Foreground="#9370DB" FontWeight="Bold" Margin="6,0,0,0" />
                </StackPanel>

                <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="4" Height="20" Margin="8,0">
                    <ProgressBar Minimum="0" Maximum="100" Value="95" 
                                 Background="Transparent" Foreground="#FF6B35" BorderThickness="0">
                        <ProgressBar.Effect>
                            <DropShadowEffect Color="#FF6B35" BlurRadius="4" ShadowDepth="1" />
                        </ProgressBar.Effect>
                    </ProgressBar>
                </Border>

                <TextBlock Grid.Column="2" Text="95%" Foreground="#FF6B35" FontWeight="Bold" FontSize="16" 
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF6B35" BlurRadius="4" ShadowDepth="1" />
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>

            <!-- DJ Status -->
            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <svgc:SvgViewbox Width="20" Height="20" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/cocktail.svg">
                        <svgc:SvgViewbox.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </svgc:SvgViewbox.Triggers>
                        <svgc:SvgViewbox.RenderTransform>
                            <RotateTransform CenterX="10" CenterY="10" />
                        </svgc:SvgViewbox.RenderTransform>
                    </svgc:SvgViewbox>
                    <TextBlock Text="DJ" Foreground="#9370DB" FontWeight="Bold" Margin="6,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text=" LIVE DJ MIX  NONSTOP MUSIC " FontSize="12" Foreground="#FF1493" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF1493" BlurRadius="6" ShadowDepth="2" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock Grid.Column="2" Text="" Foreground="#FF1493" FontWeight="Bold" FontSize="16" 
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="1" Duration="0:0:0.6" AutoReverse="True" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </Grid>

            <!-- Dance Floor Status -->
            <Grid Grid.Row="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <svgc:SvgViewbox Width="20" Height="20" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/drink.svg">
                        <svgc:SvgViewbox.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="1" Duration="0:0:1" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </svgc:SvgViewbox.Triggers>
                    </svgc:SvgViewbox>
                    <TextBlock Text="DANCE" Foreground="#9370DB" FontWeight="Bold" Margin="6,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text=" DANCE FLOOR  PARTY MODE " FontSize="12" Foreground="#FF1493" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF1493" BlurRadius="6" ShadowDepth="2" />
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock Grid.Column="2" Text="" Foreground="#FF1493" FontWeight="Bold" FontSize="16" 
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="1" Duration="0:0:0.7" AutoReverse="True" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </Grid>
        </Grid>
    </Border>
</UserControl>
