<UserControl x:Class="InnoWidget.Widgets.Ice.IceWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="280" d:DesignWidth="420">
    <Border Background="#E6F7FF" BorderBrush="#00CED1" BorderThickness="3" CornerRadius="20" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="#00CED1" BlurRadius="20" ShadowDepth="4" Opacity="0.7" />
        </Border.Effect>
        
        <Grid>
            <Canvas x:Name="SnowCanvas" IsHitTestVisible="False" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Ice Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <svgc:SvgViewbox Width="32" Height="32" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/ice.svg">
                            <svgc:SvgViewbox.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="1" Duration="0:0:2" AutoReverse="True" />
                                            <ColorAnimation Storyboard.TargetProperty="(UIElement.Fill).(SolidColorBrush.Color)" 
                                                           To="#87CEEB" Duration="0:0:3" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </svgc:SvgViewbox.Triggers>
                        </svgc:SvgViewbox>
                        <TextBlock Text="❄️ ICE MONITOR ❄️" FontSize="22" FontWeight="Bold" Foreground="#00CED1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#00CED1" BlurRadius="10" ShadowDepth="3" />
                            </TextBlock.Effect>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                           To="#87CEEB" Duration="0:0:4" AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.7" To="1" Duration="0:0:1.5" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="❄️ ARCTIC MONITORING ❄️ FREEZING TRACKER ❄️" FontSize="16" Foreground="#00CED1" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#00CED1" BlurRadius="8" ShadowDepth="3" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <Button Grid.Column="2" Width="35" Height="35" Background="Transparent" BorderThickness="0" Padding="0"
                            Command="{Binding ToggleSettingsCommand}" ToolTip="Ayarlar">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="5">
                                    <svgc:SvgViewbox Width="20" Height="20" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/settings.svg" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Temperature Bar -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <svgc:SvgViewbox Width="24" Height="24" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/ice.svg">
                            <svgc:SvgViewbox.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.4" To="1" Duration="0:0:1.5" AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.8" To="1.2" Duration="0:0:3" AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.8" To="1.2" Duration="0:0:3" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </svgc:SvgViewbox.Triggers>
                            <svgc:SvgViewbox.RenderTransform>
                                <ScaleTransform CenterX="12" CenterY="12" />
                            </svgc:SvgViewbox.RenderTransform>
                        </svgc:SvgViewbox>
                        <TextBlock Text="TEMP" Foreground="#00CED1" FontWeight="Bold" Margin="8,0,0,0" FontSize="16">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                           To="#87CEEB" Duration="0:0:2.5" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#B0E0E6" CornerRadius="15" Height="25" Margin="10,0">
                        <ProgressBar Minimum="-50" Maximum="0" Value="{Binding Temperature, Mode=OneWay}" 
                                     Background="Transparent" Foreground="#00CED1" BorderThickness="0">
                            <ProgressBar.Effect>
                                <DropShadowEffect Color="#00CED1" BlurRadius="12" ShadowDepth="3" />
                            </ProgressBar.Effect>
                            <ProgressBar.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.8" To="1" Duration="0:0:2" AutoReverse="True" />
                                            <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                           To="#87CEEB" Duration="0:0:3" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ProgressBar.Triggers>
                        </ProgressBar>
                    </Border>

                    <TextBlock Grid.Column="2" Text="{Binding Temperature, StringFormat={}{0:0}°C}" 
                               Foreground="#00CED1" FontWeight="Bold" FontSize="16" 
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#00CED1" BlurRadius="10" ShadowDepth="3" />
                        </TextBlock.Effect>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                       To="#87CEEB" Duration="0:0:2.8" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="1" Duration="0:0:1.2" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </Grid>

                <!-- Ice Thickness Bar -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <svgc:SvgViewbox Width="24" Height="24" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/crystal.svg">
                            <svgc:SvgViewbox.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:2" AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:6" />
                                            <ColorAnimation Storyboard.TargetProperty="(UIElement.Fill).(SolidColorBrush.Color)" 
                                                           To="#E6E6FA" Duration="0:0:3" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </svgc:SvgViewbox.Triggers>
                            <svgc:SvgViewbox.RenderTransform>
                                <RotateTransform CenterX="12" CenterY="12" />
                            </svgc:SvgViewbox.RenderTransform>
                        </svgc:SvgViewbox>
                        <TextBlock Text="THICK" Foreground="#00CED1" FontWeight="Bold" Margin="8,0,0,0" FontSize="16">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                           To="#E6E6FA" Duration="0:0:3.5" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#B0E0E6" CornerRadius="15" Height="25" Margin="10,0">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding IceThickness, Mode=OneWay}" 
                                     Background="Transparent" Foreground="#E6E6FA" BorderThickness="0">
                            <ProgressBar.Effect>
                                <DropShadowEffect Color="#E6E6FA" BlurRadius="12" ShadowDepth="3" />
                            </ProgressBar.Effect>
                            <ProgressBar.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.7" To="1" Duration="0:0:2.5" AutoReverse="True" />
                                            <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                           To="#00CED1" Duration="0:0:3" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ProgressBar.Triggers>
                        </ProgressBar>
                    </Border>

                    <TextBlock Grid.Column="2" Text="{Binding IceThickness, StringFormat={}{0:0}cm}" 
                               Foreground="#E6E6FA" FontWeight="Bold" FontSize="16" 
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#E6E6FA" BlurRadius="10" ShadowDepth="3" />
                        </TextBlock.Effect>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                       To="#00CED1" Duration="0:0:3.2" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="1" Duration="0:0:1.5" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </Grid>

                <!-- Snow Level Bar -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <svgc:SvgViewbox Width="24" Height="24" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/ice.svg">
                            <svgc:SvgViewbox.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.4" To="1" Duration="0:0:1.8" AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.7" To="1.3" Duration="0:0:2.5" AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.7" To="1.3" Duration="0:0:2.5" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </svgc:SvgViewbox.Triggers>
                            <svgc:SvgViewbox.RenderTransform>
                                <ScaleTransform CenterX="12" CenterY="12" />
                            </svgc:SvgViewbox.RenderTransform>
                        </svgc:SvgViewbox>
                        <TextBlock Text="SNOW" Foreground="#00CED1" FontWeight="Bold" Margin="8,0,0,0" FontSize="16">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                           To="#87CEEB" Duration="0:0:2.8" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#B0E0E6" CornerRadius="15" Height="25" Margin="10,0">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding SnowLevel, Mode=OneWay}" 
                                     Background="Transparent" Foreground="#87CEEB" BorderThickness="0">
                            <ProgressBar.Effect>
                                <DropShadowEffect Color="#87CEEB" BlurRadius="12" ShadowDepth="3" />
                            </ProgressBar.Effect>
                            <ProgressBar.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.8" To="1" Duration="0:0:3" AutoReverse="True" />
                                            <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                           To="#00CED1" Duration="0:0:3.5" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ProgressBar.Triggers>
                        </ProgressBar>
                    </Border>

                    <TextBlock Grid.Column="2" Text="{Binding SnowLevel, StringFormat={}{0:0}%}" 
                               Foreground="#87CEEB" FontWeight="Bold" FontSize="16" 
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#87CEEB" BlurRadius="10" ShadowDepth="3" />
                        </TextBlock.Effect>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                       To="#00CED1" Duration="0:0:3.8" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="1" Duration="0:0:1.8" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </Grid>

                <!-- Crystal Status -->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <svgc:SvgViewbox Width="24" Height="24" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/crystal.svg">
                            <svgc:SvgViewbox.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:1.2" AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:4" />
                                            <ColorAnimation Storyboard.TargetProperty="(UIElement.Fill).(SolidColorBrush.Color)" 
                                                           To="#FFFFFF" Duration="0:0:2" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </svgc:SvgViewbox.Triggers>
                            <svgc:SvgViewbox.RenderTransform>
                                <RotateTransform CenterX="12" CenterY="12" />
                            </svgc:SvgViewbox.RenderTransform>
                        </svgc:SvgViewbox>
                        <TextBlock Text="CRYSTAL" Foreground="#00CED1" FontWeight="Bold" Margin="8,0,0,0" FontSize="16">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                           To="#FFFFFF" Duration="0:0:3" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="❄️ ICE CRYSTALS ❄️ FROST FORMATION ❄️ GLACIER WATCH ❄️" FontSize="14" Foreground="#E6E6FA" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#E6E6FA" BlurRadius="15" ShadowDepth="4" />
                        </TextBlock.Effect>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                       To="#00CED1" Duration="0:0:4" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>

                    <TextBlock Grid.Column="2" Text="{Binding CrystalCount}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" 
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FFFFFF" BlurRadius="12" ShadowDepth="4" />
                        </TextBlock.Effect>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                       To="#87CEEB" Duration="0:0:2.5" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.4" To="1" Duration="0:0:1" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </Grid>

                <!-- Arctic Status -->
                <Grid Grid.Row="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <svgc:SvgViewbox Width="24" Height="24" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/ice.svg">
                            <svgc:SvgViewbox.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="1" Duration="0:0:2.5" AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="360" To="0" Duration="0:0:8" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </svgc:SvgViewbox.Triggers>
                            <svgc:SvgViewbox.RenderTransform>
                                <RotateTransform CenterX="12" CenterY="12" />
                            </svgc:SvgViewbox.RenderTransform>
                        </svgc:SvgViewbox>
                        <TextBlock Text="ARCTIC" Foreground="#00CED1" FontWeight="Bold" Margin="8,0,0,0" FontSize="16">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                           To="#87CEEB" Duration="0:0:3.5" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="❄️ ARCTIC ZONE ❄️ FREEZING SYSTEM ❄️ POLAR WATCH ❄️" FontSize="14" Foreground="#00CED1" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#00CED1" BlurRadius="15" ShadowDepth="5" />
                        </TextBlock.Effect>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                       To="#87CEEB" Duration="0:0:4.5" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>

                    <TextBlock Grid.Column="2" Text="❄️" Foreground="#00CED1" FontWeight="Bold" FontSize="20" 
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <ColorAnimation Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)" 
                                                       To="#FFFFFF" Duration="0:0:2" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:1.5" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.6" To="1.4" Duration="0:0:2" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.6" To="1.4" Duration="0:0:2" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                        <TextBlock.RenderTransform>
                            <ScaleTransform CenterX="10" CenterY="10" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
