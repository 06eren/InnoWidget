<UserControl x:Class="InnoWidget.Widgets.Hardware.HardwareWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:InnoWidget.Widgets.Hardware"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="180" d:DesignWidth="280">
    
    <!-- Minimal ve Şık Tasarım -->
    <Border Background="#1E1E2E" BorderBrush="#3C3C4C" BorderThickness="1" CornerRadius="12" Padding="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.3" />
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <svgc:SvgViewbox Width="24" Height="24" Stretch="Uniform" Source="pack://application:,,,/Assets/Icons/cpu.svg">
                        <svgc:SvgViewbox.Effect>
                            <DropShadowEffect Color="#00D4FF" BlurRadius="4" ShadowDepth="1" Opacity="0.6" />
                        </svgc:SvgViewbox.Effect>
                    </svgc:SvgViewbox>
                    <TextBlock Grid.Column="1" Text="System Monitor" FontFamily="Segoe UI" FontSize="14" 
                              FontWeight="SemiBold" Foreground="#FFFFFF" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- CPU -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="CPU" FontFamily="Segoe UI" FontSize="12" FontWeight="Medium" 
                          Foreground="#8B92A8" VerticalAlignment="Center"/>
                
                <ProgressBar Grid.Column="1" Height="6" Margin="12,0" 
                            Background="#2C2C3C" Foreground="#00D4FF" BorderThickness="0"
                            Value="{Binding CpuPercent}" Maximum="100">
                    <ProgressBar.Effect>
                        <DropShadowEffect Color="#00D4FF" BlurRadius="6" ShadowDepth="0" Opacity="0.8" />
                    </ProgressBar.Effect>
                </ProgressBar>
                
                <TextBlock Grid.Column="2" Text="{Binding CpuPercent, StringFormat={}{0:F0}%}" 
                          FontFamily="Segoe UI" FontSize="12" FontWeight="Medium" 
                          Foreground="#00D4FF" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right"/>
            </Grid>

            <!-- RAM -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="RAM" FontFamily="Segoe UI" FontSize="12" FontWeight="Medium" 
                          Foreground="#8B92A8" VerticalAlignment="Center"/>
                
                <ProgressBar Grid.Column="1" Height="6" Margin="12,0" 
                            Background="#2C2C3C" Foreground="#FF6B9D" BorderThickness="0"
                            Value="{Binding RamPercent}" Maximum="100">
                    <ProgressBar.Effect>
                        <DropShadowEffect Color="#FF6B9D" BlurRadius="6" ShadowDepth="0" Opacity="0.8" />
                    </ProgressBar.Effect>
                </ProgressBar>
                
                <TextBlock Grid.Column="2" Text="{Binding RamPercent, StringFormat={}{0:F0}%}" 
                          FontFamily="Segoe UI" FontSize="12" FontWeight="Medium" 
                          Foreground="#FF6B9D" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
