<Window x:Class="InnoWidget.Views.WidgetSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InnoWidget.Views"
        xmlns:hardware="clr-namespace:InnoWidget.Widgets.Hardware"
        xmlns:network="clr-namespace:InnoWidget.Widgets.Network"
        xmlns:volcano="clr-namespace:InnoWidget.Widgets.Volcano"
        xmlns:ice="clr-namespace:InnoWidget.Widgets.Ice"
        xmlns:crystal="clr-namespace:InnoWidget.Widgets.Crystal"
        xmlns:converters="clr-namespace:InnoWidget.Core.Converters"
        mc:Ignorable="d"
        Title="Widget Ayarları" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#2C3E50">
    
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#34495E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" 
                                BorderBrush="#3498DB" BorderThickness="1" CornerRadius="5,5,0,0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" 
                                            HorizontalAlignment="Center" ContentSource="Header" Margin="12,2,12,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3498DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border Background="#2C3E50" BorderBrush="#3498DB" BorderThickness="2" CornerRadius="10" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#3498DB" BlurRadius="15" ShadowDepth="3" Opacity="0.3" />
        </Border.Effect>
        
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="⚙️" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="WIDGET AYARLARI" FontSize="24" FontWeight="Bold" 
                           Foreground="#ECF0F1" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#3498DB" BlurRadius="5" ShadowDepth="1" />
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
            
            <!-- Tab Control -->
            <TabControl Grid.Row="1" Background="#34495E" BorderThickness="0">
                
                <!-- Hardware Widget Settings -->
                <TabItem Header="🌸 Hardware">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Background="#ECF0F1" CornerRadius="5" Margin="5" Padding="15">
                            <hardware:HardwareWidgetSettingsView x:Name="HardwareSettings" />
                        </Border>
                    </ScrollViewer>
                </TabItem>
                
                <!-- Network Widget Settings -->
                <TabItem Header="🌃 Network">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Background="#ECF0F1" CornerRadius="5" Margin="5" Padding="15">
                            <network:NetworkWidgetSettingsView x:Name="NetworkSettings" />
                        </Border>
                    </ScrollViewer>
                </TabItem>
                
                <!-- Volcano Widget Settings -->
                <TabItem Header="🌋 Volcano">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Background="#ECF0F1" CornerRadius="5" Margin="5" Padding="15">
                            <volcano:VolcanoWidgetSettingsView x:Name="VolcanoSettings" />
                        </Border>
                    </ScrollViewer>
                </TabItem>
                
                <!-- Ice Widget Settings -->
                <TabItem Header="❄️ Ice">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Background="#ECF0F1" CornerRadius="5" Margin="5" Padding="15">
                            <ice:IceWidgetSettingsView x:Name="IceSettings" />
                        </Border>
                    </ScrollViewer>
                </TabItem>
                
                <!-- Crystal Widget Settings -->
                <TabItem Header="💎 Crystal">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Background="#ECF0F1" CornerRadius="5" Margin="5" Padding="15">
                            <crystal:CrystalWidgetSettingsView x:Name="CrystalSettings" />
                        </Border>
                    </ScrollViewer>
                </TabItem>
                
            </TabControl>
            
            <!-- Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Tümünü Sıfırla" Background="#E74C3C" Foreground="White" 
                        FontWeight="Bold" Padding="20,10" Margin="10,0"
                        Click="ResetAll_Click">
                    <Button.Effect>
                        <DropShadowEffect Color="#E74C3C" BlurRadius="5" ShadowDepth="1" />
                    </Button.Effect>
                </Button>
                
                <Button Content="Uygula" Background="#27AE60" Foreground="White" 
                        FontWeight="Bold" Padding="20,10" Margin="10,0"
                        Click="Apply_Click">
                    <Button.Effect>
                        <DropShadowEffect Color="#27AE60" BlurRadius="5" ShadowDepth="1" />
                    </Button.Effect>
                </Button>
                
                <Button Content="Kapat" Background="#95A5A6" Foreground="White" 
                        FontWeight="Bold" Padding="20,10" Margin="10,0"
                        Click="Close_Click">
                    <Button.Effect>
                        <DropShadowEffect Color="#95A5A6" BlurRadius="5" ShadowDepth="1" />
                    </Button.Effect>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
