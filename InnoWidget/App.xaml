<Application x:Class="InnoWidget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:InnoWidget"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:shell="clr-namespace:InnoWidget.Shell"
             xmlns:hw="clr-namespace:InnoWidget.Widgets.Hardware"
             xmlns:net="clr-namespace:InnoWidget.Widgets.Network"
             xmlns:notes="clr-namespace:InnoWidget.Widgets.Notes"
             xmlns:world="clr-namespace:InnoWidget.Widgets.World"
             xmlns:media="clr-namespace:InnoWidget.Widgets.Media">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.DeepPurple.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Secondary/MaterialDesignColor.Lime.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <materialDesign:BundledTheme x:Key="MaterialDesignBundledTheme" BaseTheme="Dark" PrimaryColor="DeepPurple" SecondaryColor="Lime" />

            <SolidColorBrush x:Key="AppBrush.Window" Color="#121212" />
            <SolidColorBrush x:Key="AppBrush.Surface" Color="#1A1A1A" />
            <SolidColorBrush x:Key="AppBrush.Surface2" Color="#141414" />
            <SolidColorBrush x:Key="AppBrush.Border" Color="#2A2A2A" />
            <SolidColorBrush x:Key="AppBrush.TextPrimary" Color="#EAEAEA" />
            <SolidColorBrush x:Key="AppBrush.TextSecondary" Color="#BDBDBD" />
            <SolidColorBrush x:Key="AppBrush.TextMuted" Color="#9E9E9E" />

            <Style x:Key="AppText.Title" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="AppText.Label" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextMuted}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="AppText.Value" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="AppCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Background" Value="{DynamicResource AppBrush.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <Style x:Key="AppCard.Compact" TargetType="Border" BasedOn="{StaticResource AppCard}">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{DynamicResource AppBrush.Surface2}" />
                <Setter Property="Padding" Value="10" />
            </Style>

            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{x:Null}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}" />
            </Style>

            <Style x:Key="MediaControlButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Background" Value="{DynamicResource AppBrush.Surface2}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <DataTemplate DataType="{x:Type hw:HardwareWidgetViewModel}">
                <hw:HardwareWidgetView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type net:NetworkWidgetViewModel}">
                <net:NetworkWidgetView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type notes:NotesWidgetViewModel}">
                <notes:NotesWidgetView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type world:WorldClockWidgetViewModel}">
                <world:WorldClockWidgetView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type media:MediaWidgetViewModel}">
                <media:MediaWidgetView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
