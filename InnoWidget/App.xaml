<Application x:Class="InnoWidget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:InnoWidget"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:shell="clr-namespace:InnoWidget.Shell"
             xmlns:hw="clr-namespace:InnoWidget.Widgets.Hardware"
             xmlns:net="clr-namespace:InnoWidget.Widgets.Network"
             xmlns:notes="clr-namespace:InnoWidget.Widgets.Notes"
             xmlns:world="clr-namespace:InnoWidget.Widgets.World"
             xmlns:media="clr-namespace:InnoWidget.Widgets.Media"
             xmlns:system="clr-namespace:InnoWidget.Widgets.SystemInfo"
             xmlns:battery="clr-namespace:InnoWidget.Widgets.Battery"
             xmlns:weather="clr-namespace:InnoWidget.Widgets.Weather"
             xmlns:disk="clr-namespace:InnoWidget.Widgets.Disk"
             xmlns:process="clr-namespace:InnoWidget.Widgets.ProcessMonitor"
             xmlns:temperature="clr-namespace:InnoWidget.Widgets.Temperature">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.DeepPurple.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Secondary/MaterialDesignColor.Lime.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <materialDesign:BundledTheme x:Key="MaterialDesignBundledTheme" BaseTheme="Dark" PrimaryColor="DeepPurple" SecondaryColor="Lime" />

            <SolidColorBrush x:Key="AppBrush.Window" Color="#121212" />
            <SolidColorBrush x:Key="AppBrush.Surface" Color="#1A1A1A" />
            <SolidColorBrush x:Key="AppBrush.Surface2" Color="#141414" />
            <SolidColorBrush x:Key="AppBrush.Border" Color="#2A2A2A" />
            <SolidColorBrush x:Key="AppBrush.TextPrimary" Color="#EAEAEA" />
            <SolidColorBrush x:Key="AppBrush.TextSecondary" Color="#BDBDBD" />
            <SolidColorBrush x:Key="AppBrush.TextMuted" Color="#9E9E9E" />

            <SolidColorBrush x:Key="AppBrush.SurfaceGlass" Color="#0D0D0D" Opacity="0.85" />
            <SolidColorBrush x:Key="AppBrush.SurfaceGlass2" Color="#0A0A0A" Opacity="0.75" />

            <BlurEffect x:Key="AppBlur.Light" Radius="0" KernelType="Gaussian" />
            <BlurEffect x:Key="AppBlur.Medium" Radius="0" KernelType="Gaussian" />
            <BlurEffect x:Key="AppBlur.Heavy" Radius="0" KernelType="Gaussian" />

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="AppText.Title" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="AppText.Label" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextMuted}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="AppText.Value" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="AppCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Background" Value="{DynamicResource AppBrush.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <Style x:Key="AppCard.Compact" TargetType="Border" BasedOn="{StaticResource AppCard}">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{DynamicResource AppBrush.Surface2}" />
                <Setter Property="Padding" Value="10" />
            </Style>

            <Style x:Key="AppButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AppBrush.Surface2}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#242424" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.05" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.05" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2A2A2A" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.98" Duration="0:0:0.08" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.98" Duration="0:0:0.08" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.08" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.08" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="{DynamicResource AppBrush.Surface2}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#242424" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2A2A2A" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MediaControlButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#262626" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2D2D2D" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ToggleButton">
                <Setter Property="Width" Value="54" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <Border x:Name="Track" CornerRadius="14" Background="#2A2A2A" BorderBrush="{DynamicResource AppBrush.Border}" BorderThickness="1" />
                                <Border x:Name="Thumb" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AppBrush.TextPrimary}" HorizontalAlignment="Left" Margin="3" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                                    <Setter TargetName="Thumb" Property="Opacity" Value="0.45" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="#333333" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="#3A4A2A" />
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Thumb" Property="Width" Value="24" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Slider">
                <Setter Property="Height" Value="26" />
                <Setter Property="Foreground" Value="#B6FF3B" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid Margin="0,2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" IsHitTestVisible="False" Background="#2A2A2A" Height="6" BorderThickness="0" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" IsHitTestVisible="False" Background="#242424" Height="6" BorderThickness="0" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="14" Height="14" Background="{TemplateBinding Foreground}" BorderBrush="#000000" BorderThickness="0" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate DataType="{x:Type hw:HardwareWidgetViewModel}">
                <hw:HardwareWidgetView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type net:NetworkWidgetViewModel}">
                <net:NetworkWidgetView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type notes:NotesWidgetViewModel}">
                <notes:NotesWidgetView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type world:WorldClockWidgetViewModel}">
                <world:WorldClockWidgetView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type media:MediaWidgetViewModel}">
                <media:MediaWidgetView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type system:SystemWidgetViewModel}">
                <system:SystemWidgetView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type battery:BatteryWidgetViewModel}">
                <battery:BatteryWidgetView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type weather:WeatherWidgetViewModel}">
                <weather:WeatherWidgetView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type disk:DiskWidgetViewModel}">
                <disk:DiskWidgetView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type process:ProcessWidgetViewModel}">
                <process:ProcessWidgetView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type temperature:TemperatureWidgetViewModel}">
                <temperature:TemperatureWidgetView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
